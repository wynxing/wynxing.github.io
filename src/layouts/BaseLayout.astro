---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE, cloudflareAnalyticsToken } from '../consts';
import EdgeTools from '../components/EdgeTools.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  section?: string;
  showProgress?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = '/og.png',
  section,
  showProgress = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const displayTitle = title === SITE_TITLE ? title : `${title} - ${SITE_TITLE}`;
const isProd = import.meta.env.PROD;
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{displayTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/outfit-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    {isHome && <link rel="preload" href="/images/avatar.png" as="image" />}
    {isHome && (
      <link
        rel="preload"
        href="/fonts/source-serif-4-latin-wght-italic.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      document.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
    </script>
    {isProd && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token":"${cloudflareAnalyticsToken}"}`}
      />
    )}
  </head>
  <body class={isHome ? 'is-home' : undefined}>
    <a href="#content" class="skip-link">跳到正文</a>
    {showProgress && (
      <div class="reading-progress" aria-hidden="true"><span></span></div>
    )}
    {isHome ? (
      <EdgeTools fixed />
    ) : (
      <header class="shell-bar">
        <a class="shell-home" href="/" aria-label={SITE_TITLE}>
          <img src="/images/avatar.png" alt="" width="28" height="28" />
        </a>
        {section && <p class="shell-section">{section}</p>}
        <EdgeTools />
      </header>
    )}
    <main id="content">
      <slot />
    </main>
    {!isHome && (
      <footer class="shell-foot">
        <a href="/rss.xml">RSS</a>
      </footer>
    )}
  </body>
</html>
