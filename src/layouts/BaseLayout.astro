---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE, cloudflareAnalyticsToken } from '../consts';
import SiteNav from '../components/SiteNav.astro';
import { githubProfileUrl } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  section?: string;
  showProgress?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = '/og.png',
  showProgress = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const displayTitle = title === SITE_TITLE ? title : `${title} - ${SITE_TITLE}`;
const isProd = import.meta.env.PROD;
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{displayTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/outfit-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    {isHome && <link rel="preload" href="/images/avatar.png" as="image" />}
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') preference = saved;
        } catch {}
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = preference === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : preference;
      })();
    </script>
    {isProd && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token":"${cloudflareAnalyticsToken}"}`}
      />
    )}
  </head>
  <body class={isHome ? 'is-home' : undefined}>
    <a href="#content" class="skip-link">跳到正文</a>
    {showProgress && (
      <div class="reading-progress" aria-hidden="true"><span></span></div>
    )}
    <SiteNav />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <div><a class="footer-name" href="/">Wynn’s Save Point<span class="brand-dot">.</span></a><p>记录构建、学习和路上的想法。</p></div>
      <nav aria-label="页脚导航"><a href={githubProfileUrl} target="_blank" rel="noreferrer">GitHub ↗</a><a href="/rss.xml">RSS ↗</a><a href="/admin/">写作后台</a></nav>
      <span class="copyright">© {new Date().getFullYear()} Wynn</span>
    </footer>
  </body>
</html>
