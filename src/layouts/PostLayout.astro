---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import GiscusComments from '../components/GiscusComments.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, readingTime, tagHref, byDateDesc, entryHref, categoryLabel, statusLabel } from '../utils/content';

type Entry = CollectionEntry<'blog'> | CollectionEntry<'notes'> | CollectionEntry<'projects'>;

interface Props {
  entry: Entry;
  headings?: { depth: number; slug: string; text: string }[];
}

const { entry, headings = [] } = Astro.props;
const body = 'body' in entry ? entry.body : '';
const minutes = readingTime(body);
const isProject = entry.collection === 'projects';
const project = isProject ? entry.data : null;
const section = entry.collection === 'blog' ? '文章' : entry.collection === 'notes' ? '笔记' : '项目';
const siblings = byDateDesc(await getCollection(entry.collection, ({ data }) => !data.draft));
const position = siblings.findIndex(sibling => sibling.id === entry.id);
const previous = siblings[position + 1];
const next = position > 0 ? siblings[position - 1] : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  section={section}
  showProgress
>
  <article class="page article" data-reading-article>
    <header class="article-header">
      <a class="back-link" href={`/${entry.collection}/`}>← 返回{section}</a>
      <h1>{entry.data.title}</h1>
      <p class="standfirst">{entry.data.description}</p>
      <div class="meta-line">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        <span>{minutes}</span>
        {entry.data.updated && <span>更新 {formatDate(entry.data.updated)}</span>}
        {'category' in entry.data && <span>{categoryLabel(entry.data.category)}</span>}
        {'mood' in entry.data && <span>{entry.data.mood}</span>}
        {'status' in entry.data && <span>{statusLabel(entry.data.status)}</span>}
      </div>
      {entry.data.tags.length > 0 && (
        <ul class="tag-list" aria-label="标签">
          {entry.data.tags.map((tag) => (
            <li>
              <a class="tag" href={tagHref(entry.collection, tag)}>{tag}</a>
            </li>
          ))}
        </ul>
      )}
      {project && (project.repo || project.demo) && (
        <div class="project-links">
          {project.repo && (
            <a href={project.repo} target="_blank" rel="noreferrer">仓库</a>
          )}
          {project.demo && (
            <a href={project.demo} target="_blank" rel="noreferrer">演示</a>
          )}
        </div>
      )}
      {project && project.stack.length > 0 && (
        <ul class="tag-list" aria-label="技术栈">
          {project.stack.map((item) => <li class="tag">{item}</li>)}
        </ul>
      )}
    </header>
    <div class:list={['reading-layout', { 'has-toc': headings.some(heading => heading.depth === 2 || heading.depth === 3) }]}>
      <TableOfContents headings={headings} />
      <div class="prose" data-pagefind-body>
        <slot />
      </div>
    </div>
    <div class="article-end">
      <p class="end-mark"><span aria-hidden="true">✳</span> 这一篇，存好了。</p>
      {(previous || next) && <nav class="adjacent-posts" aria-label="相邻文章">
        {previous && <a class="glass" href={entryHref(previous)}><span class="eyebrow">← 上一篇</span><span>{previous.data.title}</span></a>}
        {next && <a class="glass" href={entryHref(next)}><span class="eyebrow">下一篇 →</span><span>{next.data.title}</span></a>}
      </nav>}
      <GiscusComments />
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.prose pre').forEach(pre => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.before(wrapper);
    wrapper.append(pre);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code';
    button.textContent = '复制代码';
    button.setAttribute('aria-live', 'polite');
    wrapper.append(button);
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || pre.textContent || '');
        button.textContent = '已复制';
      } catch { button.textContent = '复制失败，请手动选择'; }
      setTimeout(() => { button.textContent = '复制代码'; }, 2200);
    });
  });
  document.querySelectorAll<HTMLTableElement>('.prose table').forEach(table => {
    const wrapper = document.createElement('div');
    wrapper.className = 'table-scroll';
    wrapper.tabIndex = 0;
    wrapper.setAttribute('role', 'region');
    wrapper.setAttribute('aria-label', '表格，可横向滚动');
    table.before(wrapper);
    wrapper.append(table);
  });
  const progress = document.querySelector<HTMLElement>('.reading-progress span');
  const prose = document.querySelector<HTMLElement>('.prose');
  if (progress && prose) {
    let queued = false;
    const update = () => {
      const rect = prose.getBoundingClientRect();
      const total = Math.max(1, rect.height - innerHeight + 140);
      progress.style.transform = `scaleX(${Math.min(1, Math.max(0, (140 - rect.top) / total))})`;
      queued = false;
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
