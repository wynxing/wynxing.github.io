---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import GiscusComments from '../components/GiscusComments.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, readingTime, tagHref } from '../utils/content';

type Entry = CollectionEntry<'blog'> | CollectionEntry<'notes'> | CollectionEntry<'projects'>;

interface Props {
  entry: Entry;
  headings?: { depth: number; slug: string; text: string }[];
}

const { entry, headings = [] } = Astro.props;
const body = 'body' in entry ? entry.body : '';
const minutes = readingTime(body);
const isProject = entry.collection === 'projects';
const project = isProject ? entry.data : null;
---

<BaseLayout title={entry.data.title} description={entry.data.description} showProgress>
  <article class="site-shell article">
    <header class="article-header">
      <h1>{entry.data.title}</h1>
      <p class="standfirst">{entry.data.description}</p>
      <div class="meta-line">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        <span>{minutes}</span>
        {entry.data.updated && <span>更新 {formatDate(entry.data.updated)}</span>}
        {'category' in entry.data && <span>{entry.data.category}</span>}
        {'mood' in entry.data && <span>{entry.data.mood}</span>}
        {'status' in entry.data && <span>{entry.data.status}</span>}
      </div>
      {entry.data.tags.length > 0 && (
        <ul class="tag-list" aria-label="标签">
          {entry.data.tags.map((tag) => (
            <li>
              <a class="tag" href={tagHref(entry.collection, tag)}>{tag}</a>
            </li>
          ))}
        </ul>
      )}
      {project && (project.repo || project.demo) && (
        <div class="project-links">
          {project.repo && (
            <a href={project.repo} target="_blank" rel="noreferrer">仓库</a>
          )}
          {project.demo && (
            <a href={project.demo} target="_blank" rel="noreferrer">演示</a>
          )}
        </div>
      )}
      {project && project.stack.length > 0 && (
        <ul class="tag-list" aria-label="技术栈">
          {project.stack.map((item) => <li class="tag">{item}</li>)}
        </ul>
      )}
    </header>
    <TableOfContents headings={headings} />
    <div class="prose" data-pagefind-body>
      <slot />
    </div>
    <GiscusComments />
  </article>
</BaseLayout>
