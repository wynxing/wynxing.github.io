---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="没有找到" description="地址可能写错了，或者内容已经挪走。" section="迷失">
  <section class="page sheet-card missing-page">
    <div class="missing-badge" aria-hidden="true">
      <span class="missing-led"></span>
      <span>HTTP 404</span>
    </div>
    <span class="missing-number" aria-hidden="true">404</span>
    <h1>这一页没有找到</h1>
    <p class="missing-copy">地址可能写错了，或者对应页面已经调整。</p>
    <nav class="missing-links" aria-label="继续浏览">
      <a class="text-link" href="/">回首页 ↗</a>
      <a class="text-link" href="/blog/">看文章 ↗</a>
      <a class="text-link" href="/search/">搜索 ↗</a>
    </nav>
  </section>
</BaseLayout>
