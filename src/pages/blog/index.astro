---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListGrid from '../../components/ListGrid.astro';
import PostCard from '../../components/PostCard.astro';
import { byDateDesc } from '../../utils/content';

const entries = byDateDesc(await getCollection('blog', ({ data }) => !data.draft));
const tags = [...new Set(entries.flatMap(entry => entry.data.tags))].sort();
const categories = [...new Set(entries.map(entry => entry.data.category))];
---
<BaseLayout title="文章" description="技术文章、项目复盘，还有一些慢慢想明白的事。" section="文章">
  <section class="page sheet-card">
    <header class="page-header">
      <div class="page-title-row">
        <h1>文章</h1>
        <span class="page-count">{String(entries.length).padStart(2, '0')}</span>
      </div>
      <p>技术笔记、复盘与随想。</p>
    </header>
    {entries.length > 0 ? (
      <ListGrid count={entries.length} tags={tags} categories={categories} kind="blog">
        {entries.map(entry => <PostCard entry={entry} />)}
      </ListGrid>
    ) : (
      <div class="empty-state">
        <h2>暂时还没有公开的文章</h2>
        <p>可以先去看看项目记录，或者回到工作台听听歌。</p>
        <a href="/projects/">浏览项目 ↗</a>
      </div>
    )}
  </section>
</BaseLayout>
