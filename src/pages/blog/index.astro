---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListGrid from '../../components/ListGrid.astro';
import PostCard from '../../components/PostCard.astro';
import { byDateDesc } from '../../utils/content';

const posts = byDateDesc(await getCollection('blog', ({ data }) => !data.draft));
---

<BaseLayout title="文章" description="技术文章和项目复盘。" section="文章">
  <section class="page">
    <header class="page-header">
      <h1>文章</h1>
      <p>技术文章和项目复盘。</p>
    </header>
    {posts.length > 0 ? (
      <ListGrid count={posts.length}>
        {posts.map((entry) => <PostCard entry={entry} />)}
      </ListGrid>
    ) : (
      <p class="muted">还没有文章。</p>
    )}
  </section>
</BaseLayout>
