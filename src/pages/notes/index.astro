---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListGrid from '../../components/ListGrid.astro';
import PostCard from '../../components/PostCard.astro';
import { byDateDesc } from '../../utils/content';

const notes = byDateDesc(await getCollection('notes', ({ data }) => !data.draft));
---

<BaseLayout title="笔记" description="短想法和摘录。">
  <section class="site-shell list-page">
    <header class="page-header">
      <h1>笔记</h1>
      <p>短想法和摘录。</p>
    </header>
    {notes.length > 0 ? (
      <ListGrid count={notes.length}>
        {notes.map((entry) => <PostCard entry={entry} />)}
      </ListGrid>
    ) : (
      <p class="muted">还没有笔记。</p>
    )}
  </section>
</BaseLayout>
