---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListGrid from '../../components/ListGrid.astro';
import PostCard from '../../components/PostCard.astro';
import { byDateDesc } from '../../utils/content';

const projects = byDateDesc(await getCollection('projects', ({ data }) => !data.draft));
---

<BaseLayout title="项目" description="项目记录。">
  <section class="site-shell list-page">
    <header class="page-header">
      <h1>项目</h1>
      <p>项目记录。</p>
    </header>
    {projects.length > 0 ? (
      <ListGrid count={projects.length}>
        {projects.map((entry) => <PostCard entry={entry} />)}
      </ListGrid>
    ) : (
      <p class="muted">还没有项目。</p>
    )}
  </section>
</BaseLayout>
