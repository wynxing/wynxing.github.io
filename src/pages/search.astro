---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
---

<BaseLayout title="搜索" description="搜索 Wynn's Save Point 的文章与项目。" section="搜索">
  <section class="page sheet-card">
    <header class="page-header">
      <h1>搜索</h1>
      <p>按关键词检索全站文章与项目。</p>
    </header>
    <SearchBox />
  </section>
</BaseLayout>
