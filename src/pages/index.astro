---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SummerDesktop from '../components/SummerDesktop.astro';
import { byDateDesc, entryHref, formatDate } from '../utils/content';
const posts = byDateDesc(await getCollection('blog', ({ data }) => !data.draft));
const newest = posts[0];
const latest = newest ? { title: newest.data.title, href: entryHref(newest), date: formatDate(newest.data.date), datetime: newest.data.date.toISOString() } : undefined;
---
<BaseLayout>
  <SummerDesktop latest={latest}/>
</BaseLayout>
