---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkbenchHome from '../components/WorkbenchHome.astro';
import {
  byDateDesc,
  byProjectOrder,
  categoryLabel,
  entryHref,
  formatDate,
  readingTime,
  statusWithVersion,
} from '../utils/content';

const allPosts = byDateDesc(await getCollection('blog', ({ data }) => !data.draft));
const allProjects = byProjectOrder(await getCollection('projects', ({ data }) => !data.draft));

const posts = allPosts.slice(0, 3).map((post) => ({
  title: post.data.title,
  href: entryHref(post),
  date: formatDate(post.data.date),
  datetime: post.data.date.toISOString(),
  description: post.data.description,
  category: categoryLabel(post.data.category),
  readingTime: readingTime(post.body),
}));

const projects = allProjects.map((project) => ({
  title: project.data.title,
  href: entryHref(project),
  description: project.data.description,
  status: project.data.status,
  statusText: statusWithVersion(project.data.status, project.data.version),
  stack: project.data.stack.slice(0, 2).join(' · '),
}));
---
<BaseLayout>
  <WorkbenchHome projects={projects} posts={posts} />
</BaseLayout>
