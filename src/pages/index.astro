---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PulseHome from '../components/PulseHome.astro';
import {
  byDateDesc,
  byProjectOrder,
  categoryLabel,
  entryHref,
  formatDate,
  readingTime,
  statusWithVersion,
} from '../utils/content';

const allPosts = byDateDesc(await getCollection('blog', ({ data }) => !data.draft));
const allProjects = byProjectOrder(await getCollection('projects', ({ data }) => !data.draft));

const posts = allPosts.slice(0, 4).map((post) => ({
  title: post.data.title,
  href: entryHref(post),
  date: formatDate(post.data.date),
  datetime: post.data.date.toISOString(),
  description: post.data.description,
  category: categoryLabel(post.data.category),
  readingTime: readingTime(post.body),
}));

const projects = allProjects.slice(0, 4).map((project) => ({
  title: project.data.title,
  href: entryHref(project),
  description: project.data.description,
  statusText: statusWithVersion(project.data.status, project.data.version),
  role: project.data.role || '',
  highlight: project.data.highlight || project.data.description,
  stack: project.data.stack.join(' / '),
}));
---
<BaseLayout>
  <PulseHome
    projects={projects}
    posts={posts}
  />
</BaseLayout>
