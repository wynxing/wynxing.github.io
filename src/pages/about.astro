---
import BaseLayout from '../layouts/BaseLayout.astro';
import { githubProfileUrl } from '../consts';
---
<BaseLayout title="关于" description="Wynn" section="关于">
  <section class="page sheet-card about-sheet">
    <div class="about-card" data-pagefind-body>
      <div class="about-portrait">
        <div class="cat-pin cat-pin--static">
          <span class="cat-pin-plate">
            <img src="/images/avatar.png" alt="Wynn 的像素黑猫头像" width="128" height="128" />
          </span>
        </div>
      </div>
      <div class="about-info">
        <h1>Wynn</h1>
        <div class="about-links">
          <a class="text-link" href={githubProfileUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a class="text-link" href="/projects/">项目 ↗</a>
          <a class="text-link" href="/blog/">文章 ↗</a>
          <a class="text-link" href="/rss.xml" data-astro-reload>RSS ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
