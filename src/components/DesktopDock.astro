---
import AppIcon from './AppIcon.astro';
import { isCurrentPath } from '../utils/content';
const links = [
  { href: '/blog/', title: '文章', icon: 'article', color: 'blue' },
  { href: '/projects/', title: '项目', icon: 'folder-simple', color: 'green' },
  { href: '/notes/', title: '笔记', icon: 'notepad', color: 'orange' },
  { href: '/about/', title: '关于', icon: 'user', color: 'purple' },
  { href: '/search/', title: '搜索', icon: 'magnifying-glass', color: 'pink' },
];
---
<nav class="desktop-dock glass" aria-label="板块入口">
  {links.map(item => <a href={item.href} class="dock-item" aria-current={isCurrentPath(Astro.url.pathname, item.href) ? 'page' : undefined}>
    <span class={`dock-icon icon-${item.color}`}><AppIcon name={item.icon}/></span><span class="dock-label">{item.title}</span>
  </a>)}
</nav>
