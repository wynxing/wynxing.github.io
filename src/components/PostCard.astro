---
import type { CollectionEntry } from 'astro:content';
import { entryHref, formatDate } from '../utils/content';

type Entry = CollectionEntry<'blog'> | CollectionEntry<'notes'> | CollectionEntry<'projects'>;

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
---

<article class="entry" data-pagefind-ignore data-tags={entry.data.tags.join(',')}>
  <a class="entry-link" href={entryHref(entry)}>
    <time class="entry-date" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
    <h2 class="entry-title">{entry.data.title}</h2>
    <p class="entry-summary">{entry.data.description}</p>
  </a>
</article>
