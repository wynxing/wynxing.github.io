---
import { entryHref, formatDate, readingTime, categoryLabel, statusLabel, type Entry } from '../utils/content';
interface Props { entry: Entry; variant?: 'list' | 'project'; }
const { entry, variant = entry.collection === 'projects' ? 'project' : 'list' } = Astro.props;
const project = entry.collection === 'projects' ? entry.data : null;
const category = 'category' in entry.data ? entry.data.category : '';
---
<article class:list={['post-card', `post-${variant}`]} data-pagefind-ignore data-entry-card data-tags={JSON.stringify(entry.data.tags)} data-category={category}>

  <div class="card-content">
    {!project && <div class="card-meta"><span class="card-category">{category ? categoryLabel(category) : '项目记录'}</span><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time><span>{readingTime(entry.body)}</span></div>}
    <h2><a class="card-link" href={entryHref(entry)}>{entry.data.title}</a></h2>
    <p class="card-description">{entry.data.description}</p>
    {project?.role && <p class="project-role">{project.role}</p>}
    {project?.highlight && <p class="project-highlight"><span>代表成果</span>{project.highlight}</p>}
    {project && <span class="project-detail-link">查看项目详情 ↗</span>}
    {'status' in entry.data && <p class="project-status">{statusLabel(entry.data.status)}{entry.data.stack.length > 0 && <> · {entry.data.stack.join(' / ')}</>}</p>}
    {(('repo' in entry.data && entry.data.repo) || ('demo' in entry.data && entry.data.demo)) && <div class="card-extras">
      {'repo' in entry.data && entry.data.repo && <a class="card-extra" href={entry.data.repo} target="_blank" rel="noreferrer">仓库 ↗</a>}
      {'demo' in entry.data && entry.data.demo && <a class="card-extra" href={entry.data.demo} target="_blank" rel="noreferrer">演示 ↗</a>}
    </div>}
  </div>
  {!project && <span class="card-arrow" aria-hidden="true">↗</span>}
</article>
