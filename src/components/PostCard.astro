---
import type { CollectionEntry } from 'astro:content';
import InventoryTags from './InventoryTags.astro';
import { entryHref, formatDate } from '../utils/content';

type Entry = CollectionEntry<'blog'> | CollectionEntry<'notes'> | CollectionEntry<'projects'>;

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
---

<article class="card" data-pagefind-ignore data-tags={entry.data.tags.join(',')}>
  <a class="card-link" href={entryHref(entry)}>
    <div class="meta-line">
      <span>{entry.collection.toUpperCase()}</span>
      <span>·</span>
      <span>{formatDate(entry.data.date)}</span>
    </div>
    <h2>{entry.data.title}</h2>
    <p class="muted">{entry.data.description}</p>
  </a>
  <InventoryTags tags={entry.data.tags.slice(0, 3)} collection={entry.collection} />
</article>
