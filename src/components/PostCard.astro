---
import type { CollectionEntry } from 'astro:content';
import { entryHref, formatDate } from '../utils/content';

type Entry = CollectionEntry<'blog'> | CollectionEntry<'notes'> | CollectionEntry<'projects'>;

interface Props {
  entry: Entry;
}

const glyphs = {
  blog: '/images/glyph-blog.png',
  notes: '/images/glyph-notes.png',
  projects: '/images/glyph-projects.png',
} as const;

const { entry } = Astro.props;
---

<article class="index-row" data-pagefind-ignore data-tags={entry.data.tags.join(',')}>
  <a href={entryHref(entry)}>
    <img class="index-glyph" src={glyphs[entry.collection]} alt="" width="32" height="32" />
    <h2>{entry.data.title}</h2>
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
  </a>
</article>
