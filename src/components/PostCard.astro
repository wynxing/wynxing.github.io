---
import { entryHref, formatDate, readingTime, categoryLabel, statusLabel, type Entry } from '../utils/content';
interface Props { entry: Entry; featured?: boolean; index?: number; }
const { entry, featured = false, index = 1 } = Astro.props;
const category = 'category' in entry.data ? entry.data.category : '';
---
<article class:list={['post-card', 'glass', { featured, 'note-card': entry.collection === 'notes' }]} data-pagefind-ignore data-entry-card data-tags={JSON.stringify(entry.data.tags)} data-category={category}>
  <div class="card-top"><span class="eyebrow"><i class="status-dot"></i>{category ? categoryLabel(category) : entry.collection === 'notes' ? '随手记' : '项目记录'}</span><span class="card-number" aria-hidden="true">{String(index).padStart(2, '0')}</span></div>
  <h2><a class="card-link" href={entryHref(entry)}>{entry.data.title}</a></h2>
  <p class="card-description">{entry.data.description}</p>
  {'status' in entry.data && <p class="project-status">{statusLabel(entry.data.status)}{entry.data.stack.length > 0 && <> · {entry.data.stack.join(' / ')}</>}</p>}
  <div class="card-bottom"><span><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time><span class="meta-separator">/</span>{readingTime(entry.body)}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
  {'repo' in entry.data && entry.data.repo && <a class="card-extra" href={entry.data.repo} target="_blank" rel="noreferrer">仓库 ↗</a>}
  {'demo' in entry.data && entry.data.demo && <a class="card-extra" href={entry.data.demo} target="_blank" rel="noreferrer">演示 ↗</a>}
</article>