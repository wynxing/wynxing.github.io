---
import MusicPlayer from './MusicPlayer.astro';
interface Props { latest?: { title: string; href: string; date: string; datetime: string }; }
const { latest } = Astro.props;
---
<section class="summer-desktop" aria-labelledby="desktop-title">
  <div class="desktop-grid">
    <div class="desktop-identity">
      <a href="/about/" class="avatar-orbit glass" aria-label="认识 Wynn">
        <span class="avatar-glow" aria-hidden="true"></span>
        <img src="/images/avatar.png" alt="Wynn 的像素黑猫头像" width="176" height="176"/>
      </a>
      <h1 id="desktop-title">Wynn</h1>
      <p class="identity-desc">在这里，存个档。</p>
      <span class="identity-subtitle" aria-hidden="true">Good Code, Better Days.</span>
    </div>
    <div class="greeting glass">
      <span class="small-label">A LITTLE SPACE OF MY OWN</span>
      <h2 data-greeting>你好，欢迎回来。</h2>
      <p>写代码，也记下沿途。</p>
      <span class="greeting-spark" aria-hidden="true"></span>
    </div>
    <div class="music-slot" id="home-music-slot"><MusicPlayer /></div>
  </div>
  {latest && <aside class="desktop-latest glass">
    <span class="latest-badge">最近写下</span>
    <a data-latest-entry href={latest.href}>{latest.title}</a>
    <time datetime={latest.datetime}>{latest.date}</time>
    <span class="latest-arrow" aria-hidden="true">↗</span>
  </aside>}
  <div class="desktop-poem" aria-hidden="true">
    <span>代码之外</span>
    <span>还有更大的夏天。</span>
  </div>
  <p class="desktop-caption">把日子过成喜欢的样子。<span>Make room for a little sunshine.</span></p>
</section>
