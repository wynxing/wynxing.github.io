<label class="theme-control">
  <span class="sr-only">外观主题</span>
  <select aria-label="外观主题" data-theme-select>
    <option value="system">跟随系统</option>
    <option value="light">浅色</option>
    <option value="dark">深色</option>
  </select>
</label>
<script>
  const select = document.querySelector<HTMLSelectElement>('[data-theme-select]');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  let preference = document.documentElement.dataset.themePreference || 'system';
  const apply = () => {
    const theme = preference === 'system' ? (system.matches ? 'dark' : 'light') : preference;
    document.documentElement.dataset.theme = theme;
    document.documentElement.dataset.themePreference = preference;
    if (select) select.value = preference;
    document.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
  };
  select?.addEventListener('change', () => {
    preference = select.value;
    try { localStorage.setItem('theme', preference); } catch { /* Session preference still applies. */ }
    apply();
  });
  system.addEventListener('change', () => { if (preference === 'system') apply(); });
  window.addEventListener('storage', (event) => {
    if (event.key !== 'theme' && event.key !== null) return;
    preference = event.newValue === 'light' || event.newValue === 'dark' ? event.newValue : 'system';
    apply();
  });
  apply();
</script>