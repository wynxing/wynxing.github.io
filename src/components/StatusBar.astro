---
interface Props {
  entryCount: number;
  lastSaved?: Date;
  exp: number;
}

const { entryCount, lastSaved, exp } = Astro.props;
const lastSavedLabel = lastSaved
  ? lastSaved.toISOString().slice(0, 10).replaceAll('-', '.')
  : '—';
---

<aside class="pixel-frame status-panel" aria-label="Site status">
  <div class="status-row">
    <strong>Save Slot</strong>
    <span>Wynn / Personal Blog</span>
  </div>
  <div class="status-row">
    <strong>Mode</strong>
    <span>Writing, building, learning</span>
  </div>
  <div class="status-row">
    <strong>Logs</strong>
    <span>{entryCount} 条存档 · 最近 {lastSavedLabel}</span>
  </div>
  <div class="status-row">
    <strong>EXP</strong>
    <div class="exp-bar" aria-hidden="true" style={`--value: ${exp}%`}><span></span></div>
  </div>
  <div class="status-row">
    <strong>Inventory</strong>
    <span>TypeScript / React / Python / AI / Tools</span>
  </div>
</aside>
