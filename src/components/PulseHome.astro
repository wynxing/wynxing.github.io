---
import { githubProfileUrl } from '../consts';

export interface HomeProject {
  title: string;
  href: string;
  description: string;
  statusText: string;
  role: string;
  highlight: string;
  stack: string;
}

export interface HomePost {
  title: string;
  href: string;
  date: string;
  datetime: string;
  description: string;
  category: string;
  readingTime: string;
}

interface Props {
  projects: HomeProject[];
  posts: HomePost[];
  projectCount: number;
  postCount: number;
}

const { projects, posts, projectCount, postCount } = Astro.props;
const leadProject = projects[0];
const leadPost = posts[0];
const stations = [
  { id: '01', label: 'WYNN', x: 280 },
  { id: '02', label: 'WORKS', x: 820 },
  { id: '03', label: 'WRITING', x: 1380 },
  { id: '04', label: 'SIGNAL', x: 1870 },
  { id: '05', label: 'OUTPOST', x: 2280 },
];
---

<section class="pulse-home" aria-labelledby="pulse-title">
  <div class="pulse-viewport" data-pulse-viewport tabindex="0" aria-label="Wynn 的实时脉搏时间线，支持滚轮、拖拽与方向键横向探索">
    <canvas class="pulse-canvas" data-pulse-canvas aria-hidden="true"></canvas>

    <div class="pulse-stage" data-pulse-stage>
      <!-- 01 / IDENTITY (Above) & TELEMETRY MIRROR (Below) -->
      <section class="pulse-station is-above station-identity" style="left: 280px;" data-pulse-station="0" data-station-x="280">
        <div class="station-head">
          <span class="station-code"><em>01</em> IDENTITY</span>
          <span class="station-sub">SAVE POINT</span>
        </div>
        <div class="identity-hero">
          <a href="/about/" class="identity-cat" aria-label="认识 Wynn">
            <img src="/images/avatar.png" alt="Wynn 的像素黑猫头像" width="84" height="84" />
          </a>
          <div class="identity-title-wrap">
            <h1 id="pulse-title">Wynn</h1>
            <p class="identity-lead">写代码，造小工具，记下沿途。</p>
          </div>
        </div>
        <div class="station-foot">
          <span class="muted">在这里，存个档。</span>
          <a class="bare-link" href="/about/">关于 / ABOUT ↗</a>
        </div>
      </section>

      <aside class="pulse-mirror is-below station-mirror--telemetry" style="left: 280px;" data-pulse-mirror="0" aria-label="站点实时概览">
        <dl class="signal-telemetry">
          <div>
            <dt>ARCHIVE</dt>
            <dd>{String(projectCount).padStart(2, '0')} PROJECTS · {String(postCount).padStart(2, '0')} ESSAYS</dd>
          </div>
          <div>
            <dt>FOCUS</dt>
            <dd>AI Agent · Rust · Engineering</dd>
          </div>
          <div>
            <dt>CLOCK</dt>
            <dd><time data-desktop-clock aria-label="本地日期与时间"></time></dd>
          </div>
        </dl>
      </aside>

      <!-- 02 / WORKS (Below) & LIVE PROJECT INSPECT MIRROR (Above) -->
      {leadProject && (
        <aside class="pulse-mirror is-above station-mirror--hover station-mirror--project" style="left: 820px;" data-pulse-mirror="1" data-project-mirror aria-label="项目焦点预览">
          <div class="station-head">
            <span class="station-code"><em>INSPECT</em> <span data-pm-index>01/{String(projects.length).padStart(2, '0')}</span></span>
            <span class="station-sub" data-pm-stack>{leadProject.stack}</span>
          </div>
          <h2 class="mirror-title" data-pm-title>{leadProject.title}</h2>
          {leadProject.role && <p class="mirror-role" data-pm-role>{leadProject.role}</p>}
          <blockquote class="mirror-highlight" data-pm-highlight>{leadProject.highlight}</blockquote>
        </aside>
      )}

      <section class="pulse-station is-below station-projects" style="left: 820px;" data-pulse-station="1" data-station-x="820">
        <div class="station-head">
          <span class="station-code"><em>02</em> WORKS · {String(projectCount).padStart(2, '0')}</span>
          <a class="bare-link" href="/projects/">全部项目 ↗</a>
        </div>
        <ul class="bare-list bare-list--projects">
          {projects.map((project, idx) => (
            <li>
              <a
                class:list={['bare-row', { 'is-active': idx === 0 }]}
                href={project.href}
                data-project-item
                data-idx={`${String(idx + 1).padStart(2, '0')}/${String(projects.length).padStart(2, '0')}`}
                data-title={project.title}
                data-role={project.role}
                data-highlight={project.highlight}
                data-stack={project.stack}
              >
                <div class="bare-row-main">
                  <strong>{project.title}</strong>
                  <span class="bare-row-desc">{project.description}</span>
                </div>
                <span class="bare-row-meta">{project.statusText}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- 03 / WRITING (Above) & LIVE ARTICLE EXCERPT MIRROR (Below) -->
      <section class="pulse-station is-above station-writing" style="left: 1380px;" data-pulse-station="2" data-station-x="1380">
        <div class="station-head">
          <span class="station-code"><em>03</em> WRITING · {String(postCount).padStart(2, '0')}</span>
          <a class="bare-link" href="/blog/">全部文章 ↗</a>
        </div>
        {posts.length > 0 ? (
          <ul class="bare-list">
            {posts.map((post, idx) => (
              <li>
                <a
                  class:list={['bare-row', { 'is-active': idx === 0 }]}
                  href={post.href}
                  data-latest-entry={idx === 0 ? '' : undefined}
                  data-post-item
                  data-title={post.title}
                  data-desc={post.description}
                  data-meta={`${post.category} · ${post.readingTime} · ${post.date}`}
                >
                  <strong class="bare-row-title">{post.title}</strong>
                  <time class="bare-row-meta" datetime={post.datetime}>{post.date}</time>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted" style="font-size: 13px; margin: 12px 0 0;">暂时还没有公开的文章。</p>
        )}
      </section>

      {leadPost && (
        <aside class="pulse-mirror is-below station-mirror--hover station-mirror--writing" style="left: 1380px;" data-pulse-mirror="2" data-post-mirror aria-label="文章导语预览">
          <div class="station-head">
            <span class="station-code"><em>EXCERPT</em></span>
            <span class="station-sub" data-wm-meta>{leadPost.category} · {leadPost.readingTime} · {leadPost.date}</span>
          </div>
          <h2 class="mirror-title mirror-title--sm" data-wm-title>{leadPost.title}</h2>
          <p class="mirror-desc" data-wm-desc>{leadPost.description}</p>
        </aside>
      )}

      <!-- 04 / SIGNAL (Below) -->
      <section class="pulse-station is-below station-signal" style="left: 1870px;" data-pulse-station="3" data-station-x="1870">
        <div class="station-head">
          <span class="station-code"><em>04</em> SIGNAL</span>
          <a class="bare-link" href="/search/">检索全站 ↗</a>
        </div>
        <ul class="bare-list">
          <li>
            <a class="bare-row" href="/search/">
              <strong class="bare-row-title">全站索引搜索</strong>
              <span class="bare-row-meta">PAGEFIND ↗</span>
            </a>
          </li>
          <li>
            <a class="bare-row" href="/projects/">
              <strong class="bare-row-title">工程与产品交付</strong>
              <span class="bare-row-meta">{String(projectCount).padStart(2, '0')} ITEMS ↗</span>
            </a>
          </li>
          <li>
            <a class="bare-row" href="/blog/">
              <strong class="bare-row-title">文章与复盘档案</strong>
              <span class="bare-row-meta">{String(postCount).padStart(2, '0')} POSTS ↗</span>
            </a>
          </li>
        </ul>
      </section>

      <!-- 05 / OUTPOST (Above) & END OF TRACE MIRROR (Below) -->
      <section class="pulse-station is-above station-outpost" style="left: 2280px;" data-pulse-station="4" data-station-x="2280">
        <div class="station-head">
          <span class="station-code"><em>05</em> OUTPOST</span>
          <span class="station-sub">© {new Date().getFullYear()} WYNN</span>
        </div>
        <p class="outpost-statement">给走过的路，留一个存档。</p>
        <div class="outpost-links">
          <a href={githubProfileUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="/rss.xml" data-astro-reload>RSS ↗</a>
          <a href="/admin/" data-astro-reload>写作后台</a>
        </div>
      </section>

      <aside class="pulse-mirror is-below station-mirror--hover station-mirror--end" style="left: 2280px;" data-pulse-mirror="4" aria-label="坐标终点">
        <div class="station-head">
          <span class="station-code"><em>END</em> TERMINUS</span>
          <span class="station-sub">X:2280</span>
        </div>
        <p class="mirror-desc">SAVE POINT ESTABLISHED · 保持清醒与热爱。</p>
      </aside>
    </div>
  </div>

  <nav class="pulse-rail" aria-label="脉搏节点导航">
    <div class="pulse-stations">
      {stations.map((station, index) => (
        <button
          type="button"
          class="pulse-station-btn"
          data-station-jump={index}
          data-station-x={station.x}
          aria-current={index === 0 ? 'true' : undefined}
        >
          <span class="station-dot" aria-hidden="true"></span>
          <span>{station.id} {station.label}</span>
        </button>
      ))}
    </div>
    <div class="pulse-rail-track" aria-hidden="true">
      <span class="pulse-rail-fill" data-pulse-bar></span>
    </div>
    <div class="pulse-rail-telemetry">
      <span class="pulse-bpm" data-pulse-bpm>64 BPM</span>
      <span class="pulse-rail-hint" aria-hidden="true">SCROLL · DRAG · ← →</span>
    </div>
  </nav>
</section>

<script>import '../scripts/pulse-home';</script>
