---
import AppIcon from './AppIcon.astro';
import { playlist } from '../data/music';

interface Props {
  mini?: boolean;
}

const { mini = false } = Astro.props;
const opening = playlist[0];
const totalTracks = String(playlist.length).padStart(2, '0');
---
<section
  class:list={['music-player', { 'is-mini': mini }]}
  data-music-player
  data-playlist={JSON.stringify(playlist)}
  transition:persist="save-point-music"
  aria-label="音乐播放器"
>
  <audio preload="none" data-audio></audio>
  <div class="cd-deck-shell">
    <div class="cd-bay" aria-hidden="true">
      <div class="cd-disc">
        <img data-cover alt="" hidden />
        <span class="cd-iridescence"></span>
        <span class="cd-grooves"></span>
        <span class="cd-hub"></span>
      </div>
      <span class="cd-polycarbonate-glare"></span>
    </div>

    <div class="cd-body">
      <div class="cd-body-top">
        <div class="music-meta">
          <div class="deck-topline">
            <span class="deck-index" data-track-index>{opening ? `01/${totalTracks}` : '00/00'}</span>
            <span class="deck-led" aria-hidden="true"></span>
          </div>
          <strong data-track-title>{opening ? opening.title : '歌单准备中'}</strong>
          <span class="music-artist" data-track-artist>{opening ? opening.artist : '留一点时间，听听喜欢的声音。'}</span>
        </div>

        <div class="music-inline-controls">
          <button type="button" class="icon-button cd-btn" data-prev disabled aria-label="上一首">
            <AppIcon name="skip-back" />
          </button>
          <button type="button" class="play-button icon-button cd-btn" data-play disabled aria-label="播放">
            <AppIcon name="play" />
            <span data-pause hidden><AppIcon name="pause" /></span>
          </button>
          <button type="button" class="icon-button cd-btn" data-next disabled aria-label="下一首">
            <AppIcon name="skip-forward" />
          </button>
          <button
            type="button"
            class="music-expand icon-button cd-btn"
            data-expand
            aria-controls="music-details"
            aria-label="展开播放器"
            aria-expanded="false"
          >
            <AppIcon name="caret-up" />
          </button>
        </div>
      </div>

      <div class="cd-eq-strip" aria-hidden="true">
        <span class="deck-bars">
          <i data-eq-bar></i>
          <i data-eq-bar></i>
          <i data-eq-bar></i>
          <i data-eq-bar></i>
          <i data-eq-bar></i>
        </span>
      </div>
    </div>
  </div>

  <div class="music-details" id="music-details">
    <div class="music-timeline">
      <span data-elapsed>0:00</span>
      <input data-seek type="range" min="0" max="100" value="0" step="0.1" aria-label="播放进度" disabled />
      <span data-duration>0:00</span>
    </div>
    <div class="music-controls">
      <span class="music-note" data-music-note>此刻歌单</span>
      <label class="volume-control">
        <AppIcon name="speaker-high" />
        <input data-volume type="range" min="0" max="1" step="0.01" value="0.7" aria-label="音量" disabled />
      </label>
    </div>
    {playlist.length > 0 && <p class="music-credits">曲目已以 CC0 奉献至公共领域。</p>}
  </div>

  <p data-music-error class="music-error" role="status" hidden></p>
  <noscript><p class="music-error">启用 JavaScript 后可以使用播放器。</p></noscript>
</section>
<script>import '../scripts/music-player';</script>
