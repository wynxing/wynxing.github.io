---
import EmptySaveSlot from './EmptySaveSlot.astro';

interface Props {
  count: number;
}

const { count } = Astro.props;
const emptySlots = count > 0 && count < 3 ? 3 - count : count === 0 ? 3 : 0;
const clearHref = Astro.url.pathname;
---

<div class="list-toolbar" data-tag-toolbar hidden>
  <p class="meta-line">
    <span>Filter</span>
    <span>·</span>
    <span data-tag-name></span>
  </p>
  <a class="pixel-button" href={clearHref}>清除筛选</a>
</div>
<div class="card-grid" data-card-grid data-count={count}>
  <slot />
  {Array.from({ length: emptySlots }, () => <EmptySaveSlot />)}
</div>
<p class="muted" data-tag-empty hidden>没有带这个标签的存档。</p>

<script>
  const params = new URLSearchParams(window.location.search);
  const tag = params.get('tag');
  const toolbar = document.querySelector<HTMLElement>('[data-tag-toolbar]');
  const label = document.querySelector<HTMLElement>('[data-tag-name]');
  const empty = document.querySelector<HTMLElement>('[data-tag-empty]');
  const grid = document.querySelector<HTMLElement>('[data-card-grid]');

  if (tag && toolbar && label && grid) {
    toolbar.hidden = false;
    label.textContent = `#${tag}`;

    const cards = [...grid.querySelectorAll<HTMLElement>('[data-tags]')];
    let visible = 0;

    for (const card of cards) {
      const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
      const match = tags.includes(tag);
      card.hidden = !match;
      if (match) visible += 1;
    }

    for (const slot of grid.querySelectorAll<HTMLElement>('[data-empty-slot]')) {
      slot.hidden = true;
    }

    grid.dataset.count = String(visible);
    if (empty) empty.hidden = visible > 0;
  }
</script>
