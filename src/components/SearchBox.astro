<section class="search-panel">
  <div id="search"></div>
  <p class="muted" data-search-fallback>搜索索引会在生产构建后生成。本地请先运行 pnpm build，再用 preview 打开。</p>
</section>

<script>
  const fallback = document.querySelector<HTMLElement>('[data-search-fallback]');
  const pagefindUiPath = '/pagefind/pagefind-ui.js';

  import(/* @vite-ignore */ pagefindUiPath)
    .then(() => {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/pagefind/pagefind-ui.css';
      document.head.append(link);

      const theme = document.createElement('style');
      theme.textContent = `
        .pagefind-ui {
          --pagefind-ui-primary: var(--stamp);
          --pagefind-ui-text: var(--text);
          --pagefind-ui-background: var(--surface);
          --pagefind-ui-border: var(--line);
          --pagefind-ui-border-width: 1px;
          --pagefind-ui-border-radius: 6px;
          --pagefind-ui-font: var(--sans);
          --pagefind-ui-tag: var(--stamp-soft);
        }
        .pagefind-ui__search-input {
          border-radius: 6px !important;
          box-shadow: none !important;
        }
        .pagefind-ui__result-link { color: var(--text) !important; font-family: var(--sans) !important; }
        .pagefind-ui__result-excerpt { color: var(--muted) !important; }
      `;
      document.head.append(theme);

      if ('PagefindUI' in window) {
        // @ts-expect-error PagefindUI is provided by the generated Pagefind bundle.
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: '搜索文章',
            clear_search: '清空',
            load_more: '加载更多',
            search_label: '搜索',
            filters_label: '筛选',
            zero_results: '没有找到结果',
            many_results: '[COUNT] 个结果',
            one_result: '[COUNT] 个结果',
            searching: '搜索中...',
          },
        });
        fallback?.remove();
      }
    })
    .catch(() => {
      if (fallback) fallback.hidden = false;
    });
</script>
