---
import MusicPlayer from './MusicPlayer.astro';
import ThemeToggle from './ThemeToggle.astro';
import { isCurrentPath } from '../utils/content';

const links = [
  ['/blog/', '文章'],
  ['/projects/', '项目'],
  ['/about/', '关于'],
  ['/search/', '搜索'],
];
---
<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Wynn’s Save Point 返回首页">
      <span class="brand-pin">
        <img src="/images/avatar.png" alt="" width="22" height="22" />
      </span>
      <span class="brand-name">Wynn</span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {links.map(([href, label]) => (
        <a href={href} aria-current={isCurrentPath(Astro.url.pathname, href) ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="nav-tools">
      <div class="nav-music-slot" id="music-home">
        <MusicPlayer mini />
      </div>
      <ThemeToggle showRocker />
    </div>
  </div>
</header>
