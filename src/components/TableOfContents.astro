---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const headings = (Astro.props.headings ?? []).filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

{headings.length >= 3 && (
  <nav class="pixel-frame toc" aria-label="目录">
    <p class="eyebrow">Contents</p>
    <ol>
      {headings.map((heading) => (
        <li class={`toc-d${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
